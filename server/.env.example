# Puerto donde escucha el backend (por defecto 3000)
PORT=3000

# Cadena larga y aleatoria para firmar las cookies de sesión. ¡Cámbiala!
SESSION_SECRET=cambia-este-valor-por-una-cadena-larga-y-aleatoria

# development | production (en production la cookie de sesión usa Secure)
NODE_ENV=development

# Orígenes permitidos para CORS, separados por comas (sin barra final ni rutas).
# Ejemplo: https://joaqalmonacid-star.github.io,https://ferreteria-a-m.joaq-almonacid.workers.dev
# Déjalo vacío si sirves el HTML desde el propio backend.
ALLOWED_ORIGIN=

# Brevo (API key SMTP). Se guarda aquí, NUNCA en el HTML.
BREVO_API_KEY=

# Remitente verificado en Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ferretería A&M
